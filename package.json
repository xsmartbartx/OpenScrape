{
  "name": "openscrape",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable no-code web data platform",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "start:api": "pnpm --filter @openscrape/api start",
    "start:worker": "pnpm --filter @openscrape/worker start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
