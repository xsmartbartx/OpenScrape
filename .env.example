POSTGRES_USER=openscrape
POSTGRES_PASSWORD=openscrape-dev
POSTGRES_DB=openscrape
DATABASE_URL=postgresql://openscrape:openscrape-dev@localhost:5432/openscrape
REDIS_URL=redis://localhost:6379
# For hosted Redis use: rediss://:password@host:6380
MINIO_ROOT_USER=openscrape
MINIO_ROOT_PASSWORD=openscrape-dev-secret
