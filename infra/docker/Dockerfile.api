FROM mcr.microsoft.com/playwright:v1.63.0-noble

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY infra/docker/entrypoint.sh ./infra/docker/entrypoint.sh
RUN chmod +x ./infra/docker/entrypoint.sh

RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter @openscrape/api exec prisma generate --schema prisma/schema.prisma
RUN pnpm --filter @openscrape/api build

ENV NODE_ENV=production
EXPOSE 3001
ENTRYPOINT ["/app/infra/docker/entrypoint.sh"]
CMD ["pnpm", "--filter", "@openscrape/api", "start:prod"]